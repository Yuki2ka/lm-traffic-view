graph TD
    subgraph User_Interface [Frontend]
        UI[index.html]
    end

    subgraph Management_Server [proxy.py - Control Plane]
        API[FastAPI Management API]
        Hub[Event Hub / WebSocket Server]
        ProcMgr[Subprocess Manager]
    end

    subgraph Proxy_Worker [proxy_worker.py - Data Plane]
        Worker[FastAPI Proxy Worker]
    end

    subgraph External [Target]
        Server[LLM Server - LM Studio/Ollama]
        Agent[AI Agent/Client]
    end

    %% Control Flow
    UI -- "1. Configure/Scan" --> API
    API -- "2. Start/Stop" --> ProcMgr
    ProcMgr -- "3. Spawns" --> Worker

    %% Data Flow
    Agent -- "HTTP Request" --> Worker
    Worker -- "Forward Request" --> Server
    Server -- "HTTP Response / SSE Stream" --> Worker
    Worker -- "Forward Response" --> Agent

    %% Observation Flow
    Worker -- "POST /api/event (Summaries)" --> API
    API --> Hub
    Hub -- "WebSocket (_ws)" --> UI
